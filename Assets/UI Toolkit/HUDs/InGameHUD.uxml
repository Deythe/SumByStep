<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="CustomRoot" picking-mode="Ignore" style="flex-grow: 0; flex-shrink: 0; flex-basis: 100%; justify-content: space-between;">
        <ui:ProgressBar value="50" name="LifeProgressBar" style="top: 0%; margin-top: 10%; margin-right: 2%; margin-bottom: 2%; margin-left: 2%;" />
        <ui:Button text="Off" name="FreeCameraButton" style="align-self: flex-end; margin-bottom: 5%;" />
        <ui:Button text="Cancel" name="CancelButton" style="align-self: center; margin-bottom: 5%;" />
    </ui:VisualElement>
</ui:UXML>
